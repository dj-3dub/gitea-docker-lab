---
extends: default

ignore: |
  .terraform/
  backups/

rules:
  line-length:
    max: 140
  truthy:
    allowed-values: ["true", "false"]
    check-keys: false
  comments:
    min-spaces-from-content: 1
  document-start: disable
  braces:
    max-spaces-inside: 1
  # Required by ansible-lint compatibility.
  comments-indentation: false
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
