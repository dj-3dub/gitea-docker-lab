# ==========================================================
# Gitea lab configuration (the only file you need to edit)
# `make bootstrap` copies this to .env and replaces every
# __GENERATE__ value with a random value. Never commit .env.
# scripts/tf.sh passes these to Terraform as TF_VAR_* values.
#
# The database password and Gitea's SECRET_KEY are NOT here:
# bootstrap generates them in secrets/ (mode 600), and the
# containers read them from read-only mounts, so they never
# appear in Terraform state or `docker inspect`.
# ==========================================================

# Prefix for container, network and volume names.
LAB_NAME=gitea-lab

# ---------- Versions ----------
GITEA_VERSION=28.4.0
# Changing the MAJOR version (e.g. 19 -> 20) needs `make upgrade-postgres`;
# `make up` refuses to start a new major on old data.
POSTGRES_VERSION=19-alpine
# Image used when Terraform is not installed locally (or TF_MODE=docker).
TERRAFORM_VERSION=1.17.2

# ---------- Gitea ----------
# Owner of files in the data volume; bootstrap sets these to your id -u / id -g.
USER_UID=1000
USER_GID=1000
TZ=UTC

GITEA_DOMAIN=localhost
GITEA_ROOT_URL=http://localhost:3000/
GITEA_SSH_DOMAIN=localhost

# Host ports. Bind to 127.0.0.1 to keep a port off the LAN.
GITEA_HTTP_BIND=0.0.0.0
GITEA_HTTP_PORT=3000
GITEA_SSH_BIND=0.0.0.0
GITEA_SSH_PORT=2222

GITEA_DISABLE_REGISTRATION=true
GITEA_REQUIRE_SIGNIN_VIEW=false
GITEA_LOG_LEVEL=Info

# Initial admin account, created by `make admin`.
# ("admin" is reserved by Gitea, so pick another name.)
GITEA_ADMIN_USER=gitadmin
GITEA_ADMIN_EMAIL=admin@example.com
GITEA_ADMIN_PASSWORD=__GENERATE__

# ---------- PostgreSQL ----------
POSTGRES_DB=gitea
POSTGRES_USER=gitea

# ---------- Backups ----------
BACKUP_DIR=backups
BACKUP_KEEP=7
# 1 = stop Gitea during backups for a consistent snapshot (seconds of downtime)
BACKUP_STOP_GITEA=1
# When `make schedule` runs backups (cron syntax; default 03:30 daily).
BACKUP_SCHEDULE="30 3 * * *"
# Optional: POST a message here when a backup fails, e.g. https://ntfy.sh/<topic>
BACKUP_NOTIFY_URL=

# ---------- Off-site backups (optional, encrypted with restic) ----------
# Empty = off. When set, every backup is also uploaded. Examples:
#   /mnt/nas/gitea-backups              (local path or mounted NAS share)
#   s3:https://s3.amazonaws.com/my-bucket/gitea-lab
#   b2:my-bucket:gitea-lab
#   rest:https://user:pass@backup.example.com/gitea-lab
# Encryption password: secrets/restic_password (generated by bootstrap).
# KEEP A COPY OF THAT PASSWORD OFF THIS MACHINE, or the copies are useless.
RESTIC_REPOSITORY=
RESTIC_VERSION=0.20.0
OFFSITE_KEEP="--keep-daily 7 --keep-weekly 4 --keep-monthly 6"
# Backend credentials, only if your RESTIC_REPOSITORY needs them:
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
B2_ACCOUNT_ID=
B2_ACCOUNT_KEY=
